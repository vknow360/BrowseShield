# Generic VLM Provider Configuration
# Defaults to local Ollama if not set: http://localhost:11434/v1/chat/completions
VLM_BASE_URL=
VLM_MODEL=

# API Key (Required for cloud VLMs like OpenRouter, Groq, OpenAI)
VLM_API_KEY=

# Optional: Set to 'true' to save received redacted screenshots to server/debug_images/
AGENT_DEBUG=false